        // Fungsi Modal Inspector Struktur Tugas
        function openStructureModal() {
            document.getElementById('structureModal').classList.add('active');
        }

        function closeStructureModal() {
            document.getElementById('structureModal').classList.remove('active');
        }

        function showCodeTab(key, event) {
            document.querySelectorAll('.file-tab').forEach(tab => tab.classList.remove('active'));
            if(event) event.target.classList.add('active');
            
            const codeViewer = document.querySelector('#codeContainer code');
            codeViewer.textContent = codeFiles[key] || '';
        }

        function copyCodeContent() {
            const codeText = document.querySelector('#codeContainer code').textContent;
            navigator.clipboard.writeText(codeText).then(() => {
                const btn = document.querySelector('.btn-copy');
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Tersalin!';
                setTimeout(() => {
                    btn.innerHTML = '<i class="fa-regular fa-copy"></i> Salin Kode';
                }, 2000);
            });
        }

        // Navigasi Smooth Switch Page
        function switchPage(pageKey, event) {
            if (event) {
                event.preventDefault();
            }
            
            document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
            if(event && event.target) {
                event.target.classList.add('active');
            }

            const targetElement = document.getElementById(pageKey === 'home' ? 'home-view' : pageKey + '-section') || document.getElementById(pageKey);
            if(targetElement) {
                targetElement.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function playSong(songTitle) {
            const toast = document.createElement('div');
            toast.style.position = 'fixed';
            toast.style.bottom = '20px';
            toast.style.right = '20px';
            toast.style.background = 'var(--accent-gold)';
            toast.style.color = '#000';
            toast.style.padding = '12px 20px';
            toast.style.borderRadius = '8px';
            toast.style.fontWeight = 'bold';
            toast.style.zIndex = '3000';
            toast.innerHTML = `<i class="fa-solid fa-music"></i> Memutar preview: ${songTitle}`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        function buyTicket(city) {
            const toast = document.createElement('div');
            toast.style.position = 'fixed';
            toast.style.bottom = '20px';
            toast.style.right = '20px';
            toast.style.background = 'var(--accent-crimson)';
            toast.style.color = '#fff';
            toast.style.padding = '12px 20px';
            toast.style.borderRadius = '8px';
            toast.style.fontWeight = 'bold';
            toast.style.zIndex = '3000';
            toast.innerHTML = `<i class="fa-solid fa-ticket"></i> Mengalihkan ke tiket Pesta Rakyat ${city}...`;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            document.getElementById('form-success').style.display = 'block';
            event.target.reset();
            setTimeout(() => {
                document.getElementById('form-success').style.display = 'none';
            }, 5000);
        }

        function toggleMobileMenu() {
            const navLinks = document.querySelector('.nav-links');
            if(navLinks.style.display === 'flex') {
                navLinks.style.display = 'none';
            } else {
                navLinks.style.display = 'flex';
                navLinks.style.flexDirection = 'column';
                navLinks.style.position = 'absolute';
                navLinks.style.top = '70px';
                navLinks.style.left = '0';
                navLinks.style.right = '0';
                navLinks.style.background = 'var(--bg-card)';
                navLinks.style.padding = '1.5rem';
                navLinks.style.borderBottom = '1px solid var(--border-color)';
            }
        }
    </script>
